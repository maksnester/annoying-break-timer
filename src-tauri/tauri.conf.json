{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "macos-timer",
  "version": "0.1.0",
  "identifier": "com.maksim.macostimer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Focus Timer",
        "width": 360,
        "height": 260,
        "center": true,
        "visible": true,
        "focus": true,
        "alwaysOnTop": true,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "closable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
